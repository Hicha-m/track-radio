DATABASE_URL=sqlite:///./data/radio.db
PORT=8080
BIND_ADDRESS=127.0.0.1
ADMIN_TOKEN=
ADMIN_SESSION_HOURS=8
POLL_INTERVAL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=12
COLLECTOR_CONCURRENCY=3
MAX_STATIONS=50
RETENTION_DAYS=180
ARCHIVE_DIRECTORY=data/archives
LOG_LEVEL=INFO

# Spotify : identifiants serveur uniquement ; facultatifs pour Deezer/iTunes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm : clé serveur pour track.search ; aucun secret partagé requis.
LASTFM_API_KEY=
# YouTube : recherche de vidéos intégrables à la demande ; clé privée serveur.
YOUTUBE_API_KEY=
YOUTUBE_SEARCHES_PER_DAY=80
